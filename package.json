{
  "name": "haqdaar",
  "private": true,
  "description": "Haqdaar — help a low-literacy citizen claim a (mock) relief payment end to end. Prototype only.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm run build:packages && pnpm --filter \"./services/*\" run build",
    "dev": "pnpm run build:packages && pnpm --parallel --filter \"./services/*\" run dev",
    "dev:web": "pnpm --filter @haqdaar/web dev",
    "start": "node scripts/run-all.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "prettier --check \"**/*.{ts,tsx,json,md}\" --log-level warn",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:push": "pnpm --filter \"./services/*\" run db:push",
    "db:generate": "pnpm --filter \"./services/*\" run db:generate",
    "db:seed": "pnpm --filter \"./services/*\" run db:seed",
    "keys": "node scripts/gen-keys.mjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "prettier": "^3.3.3",
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12"
  }
}

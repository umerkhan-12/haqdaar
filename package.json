{
  "name": "haqdaar",
  "private": true,
  "description": "Haqdaar — help a low-literacy citizen claim a (mock) relief payment end to end. Prototype only.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build": "pnpm run build:packages && pnpm --filter \"./services/*\" --parallel run build",
    "dev": "pnpm run build:packages && pnpm --parallel --filter \"./services/*\" run dev",
    "dev:web": "pnpm --filter @haqdaar/web dev",
    "start": "node scripts/run-all.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "prettier --check \"**/*.{ts,tsx,json,md}\" --log-level warn",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:push": "pnpm --filter \"./services/*\" run db:push",
    "db:generate": "pnpm --filter \"./services/*\" run db:generate",
    "db:seed": "pnpm --filter \"./services/*\" run db:seed",
    "knowledge:ingest": "pnpm --filter @haqdaar/knowledge run ingest",
    "knowledge:eval": "pnpm --filter @haqdaar/knowledge run eval",
    "eval:ai": "pnpm --filter @haqdaar/ai run eval:ai",
    "eval:voice": "node services/ai/scripts/eval-voice.mjs",
    "keys": "node scripts/gen-keys.mjs",
    "e2e": "node scripts/reset-demo.mjs && node scripts/e2e.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "chaos": "node scripts/reset-demo.mjs && node scripts/chaos.mjs",
    "load": "node scripts/load.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "audio": "node services/ai/scripts/gen-audio.mjs",
    "db:migrate": "pnpm --filter \"./services/*\" run db:migrate"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "prettier": "^3.3.3",
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12"
  }
}

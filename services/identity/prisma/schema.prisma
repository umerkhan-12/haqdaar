// Identity service — owns the `identity` schema. No other service reads these tables.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

enum TenantType {
  relief
  fraud_desk
}

enum Role {
  citizen
  helper
  officer
  admin
  auditor
}

enum ConsentStatus {
  ACTIVE
  WITHDRAWN
}

model Tenant {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String
  type                TenantType
  /// Requests per calendar month (UTC) through the gateway; usage shows percent used, nothing is blocked
  monthlyRequestQuota Int        @default(100000) @map("monthly_request_quota")
  /// Platform admin who launched it; null for seeded tenants
  createdBy           String?    @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  users               User[]
  apiKeys             ApiKey[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  role         Role
  name         String
  /// AES-256-GCM ciphertext; never stored in plain text
  phoneEnc     String   @map("phone_enc")
  /// HMAC-SHA256 of the phone, used for login lookup
  phoneHash    String   @unique @map("phone_hash")
  passwordHash String   @map("password_hash")
  /// Helper Mode / citizen quick PIN (argon2id)
  pinHash      String?  @map("pin_hash")
  /// Citizen users point to their person record in the cases service
  personId     String?  @map("person_id") @db.Uuid
  failedLogins Int      @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  active       Boolean  @default(true)
  /// Platform operator: may launch programs (tenants) and read every tenant's usage. Only seeded, never via API.
  platformAdmin Boolean @default(false) @map("platform_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  helperLinks   HelperLink[]

  @@index([tenantId, role])
  @@map("users")
}

/// Opaque refresh tokens, stored hashed. A family = one login session.
/// Reusing a rotated token revokes the whole family (token theft detection).
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  rotatedAt   DateTime? @map("rotated_at")
  revokedAt   DateTime? @map("revoked_at")
  /// Helper Mode: the person this session acts for
  onBehalfOf  String?   @map("on_behalf_of") @db.Uuid
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@map("refresh_tokens")
}

/// Which families a helper may act for (each needs that family's PIN to switch).
model HelperLink {
  id        String   @id @default(uuid()) @db.Uuid
  helperId  String   @map("helper_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  label     String
  pinHash   String   @map("pin_hash")
  failedPins Int     @default(0) @map("failed_pins")
  lockedUntil DateTime? @map("locked_until")
  createdAt DateTime @default(now()) @map("created_at")

  helper User @relation(fields: [helperId], references: [id])

  @@unique([helperId, personId])
  @@map("helper_links")
}

/// Sign-up one-time codes: one live code per phone, stored hashed, single use.
model SignupCode {
  /// HMAC-SHA256 of the phone (same as users.phone_hash); the phone itself is not stored
  phoneHash String    @id @map("phone_hash")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  /// Tries made against this code; more than 5 kills it
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("signup_codes")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  /// First chars shown in the UI, e.g. "hq_live_ab12"
  prefix     String
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_keys")
}

/// Consent given by a person (citizen) for a purpose. Withdrawal takes effect immediately.
model Consent {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  personId    String        @map("person_id") @db.Uuid
  purpose     String
  /// Who may use the data (e.g. a helper user id); null = the program itself
  grantedTo   String?       @map("granted_to")
  status      ConsentStatus @default(ACTIVE)
  grantedAt   DateTime      @default(now()) @map("granted_at")
  withdrawnAt DateTime?     @map("withdrawn_at")

  @@index([personId, purpose, status])
  @@map("consents")
}

/// Requests per tenant, UTC day and service, counted by the gateway and flushed every 15 s.
model UsageDaily {
  tenantId String   @map("tenant_id") @db.Uuid
  day      DateTime @db.Date
  service  String
  requests Int      @default(0)
  /// Responses with status >= 500 (including 503 when the upstream is down)
  errors   Int      @default(0)

  @@id([tenantId, day, service])
  @@map("usage_daily")
}

/// AI calls per tenant and UTC day, from `ai.call.completed` events that carry a tenant id.
model AiUsageDaily {
  tenantId  String   @map("tenant_id") @db.Uuid
  day       DateTime @db.Date
  calls     Int      @default(0)
  failures  Int      @default(0)
  fallbacks Int      @default(0)

  @@id([tenantId, day])
  @@map("ai_usage_daily")
}

/// Idempotent consumers: an event id is processed at most once.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

/// Transactional outbox: written in the same transaction as the change, published by the relay.
model OutboxEvent {
  id          String    @id @db.Uuid
  type        String
  envelope    Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

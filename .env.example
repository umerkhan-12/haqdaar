# Haqdaar — environment. Copy with `pnpm keys` (creates .env with fresh secrets).
# NEVER commit .env.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=1
CORS_ORIGINS=http://localhost:3000

# ---------- Database (local: `pnpm db:up`; cloud: Supabase session pooler / direct) ----------
# One Postgres, one schema per service. Services never read each other's schema.
IDENTITY_DATABASE_URL=postgresql://haqdaar:haqdaar@localhost:5433/haqdaar?schema=identity
CASES_DATABASE_URL=postgresql://haqdaar:haqdaar@localhost:5433/haqdaar?schema=cases
PAYMENTS_DATABASE_URL=postgresql://haqdaar:haqdaar@localhost:5433/haqdaar?schema=payments
AUDIT_DATABASE_URL=postgresql://haqdaar:haqdaar@localhost:5433/haqdaar?schema=audit
# Event bus (pg-boss uses its own `pgboss` schema in the same database)
BUS_DATABASE_URL=postgresql://haqdaar:haqdaar@localhost:5433/haqdaar

# ---------- Service URLs (defaults to localhost:<port>) ----------
GATEWAY_URL=http://localhost:4000
IDENTITY_URL=http://localhost:4001
CASES_URL=http://localhost:4002
AI_URL=http://localhost:4003
PAYMENTS_URL=http://localhost:4004
AUDIT_URL=http://localhost:4005
RAILS_URL=http://localhost:4006

# ---------- Secrets (generated by `pnpm keys`) ----------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_SECRET=
PII_ENC_KEY=
PII_HASH_KEY=
SEAL_SECRET=
WEBHOOK_SIGNING_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---------- AI ----------
# dev = Groq first (free) | demo = paid Gemini first (judging day only) | offline = deterministic mock
AI_PROFILE=dev
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
# Free Gemini key: fallback during the build
GEMINI_API_KEY=
# Paid Gemini key: used ONLY when AI_PROFILE=demo
GEMINI_DEMO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000

# ---------- Observability (optional) ----------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
RESEND_API_KEY=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000

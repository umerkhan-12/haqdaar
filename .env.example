# Haqdaar — environment. Copy with `pnpm keys` (creates .env with fresh secrets).
# NEVER commit .env.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=1
CORS_ORIGINS=http://localhost:3000

# ---------- Database (local: `pnpm db:up`; cloud: Supabase session pooler / direct) ----------
# One Postgres, one schema per service. Services never read each other's schema.
IDENTITY_DATABASE_URL=postgresql://haqdaar:haqdaar@127.0.0.1:5433/haqdaar?schema=identity
CASES_DATABASE_URL=postgresql://haqdaar:haqdaar@127.0.0.1:5433/haqdaar?schema=cases
PAYMENTS_DATABASE_URL=postgresql://haqdaar:haqdaar@127.0.0.1:5433/haqdaar?schema=payments
AUDIT_DATABASE_URL=postgresql://haqdaar:haqdaar@127.0.0.1:5433/haqdaar?schema=audit
KNOWLEDGE_DATABASE_URL=postgresql://haqdaar:haqdaar@127.0.0.1:5433/haqdaar?schema=knowledge
# Event bus (pg-boss uses its own `pgboss` schema in the same database)
BUS_DATABASE_URL=postgresql://haqdaar:haqdaar@127.0.0.1:5433/haqdaar

# ---------- Service URLs (defaults to localhost:<port>) ----------
GATEWAY_URL=http://127.0.0.1:4000
IDENTITY_URL=http://127.0.0.1:4001
CASES_URL=http://127.0.0.1:4002
AI_URL=http://127.0.0.1:4003
PAYMENTS_URL=http://127.0.0.1:4004
AUDIT_URL=http://127.0.0.1:4005
RAILS_URL=http://127.0.0.1:4006
JUDGE_URL=http://127.0.0.1:4007
KNOWLEDGE_URL=http://127.0.0.1:4008

# Judge Mode + demo reset endpoints. 1 only for demo/judging deployments, never production.
DEMO_MODE=1
DEMO_PASSWORD=demo1234

# ---------- Secrets (generated by `pnpm keys`) ----------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_SECRET=
PII_ENC_KEY=
PII_HASH_KEY=
SEAL_SECRET=
WEBHOOK_SIGNING_SECRET=
AUTO_APPROVE_AMOUNT_CAP_PKR=15000
# Review signals only; detections never reject or cancel settled payments.
ANOMALY_SHARED_PAYOUT_PEOPLE=2
# Distinct families one helper may file for in an hour before those claims go to an officer.
ANOMALY_HELPER_CLAIMS_PER_HOUR=10
ANOMALY_HOUSEHOLD_PATTERN_PEOPLE=5
ANOMALY_IDENTITY_CORROBORATION_DETAILS=2
MAKER_CHECKER_LIMIT_PKR=20000
PROGRAM_DEBTOR_IBAN=PK00SAHA0000000000000001
PROGRAM_DEBTOR_NAME=SAHARA RELIEF PROGRAM
RAAST_TIMEOUT_MS=3000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---------- AI ----------
# dev = Groq first (free) | demo = paid Gemini first (judging day only) | offline = deterministic mock
AI_PROFILE=dev
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
# Free Gemini key: fallback during the build
GEMINI_API_KEY=
# Paid Gemini key: used ONLY when AI_PROFILE=demo
GEMINI_DEMO_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# text-embedding-004 is retired; current Gemini text embeddings use gemini-embedding-001.
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_RELEVANCE_THRESHOLD=0.32
KNOWLEDGE_OFFLINE_THRESHOLD=0.12
AI_TIMEOUT_MS=20000
# Optional rates for `pnpm eval:ai` cost estimates (USD per million tokens).
# Leave blank when unknown; the evaluator reports cost as unavailable, never as zero.
AI_EVAL_PRICING_AS_OF=
AI_EVAL_GROQ_INPUT_USD_PER_MILLION=
AI_EVAL_GROQ_OUTPUT_USD_PER_MILLION=
AI_EVAL_GEMINI_INPUT_USD_PER_MILLION=
AI_EVAL_GEMINI_OUTPUT_USD_PER_MILLION=
AI_EVAL_GEMINI_DEMO_INPUT_USD_PER_MILLION=
AI_EVAL_GEMINI_DEMO_OUTPUT_USD_PER_MILLION=

# ---------- Observability (optional) ----------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
RESEND_API_KEY=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
